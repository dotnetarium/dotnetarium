<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <!-- Compiler build shipped in .NET SDK 11.0.100; stable NuGet packages are not yet published. -->
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-tools/nuget/v3/index.json</RestoreAdditionalProjectSources>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnetarium</ToolCommandName>
    <PackageId>dotnetarium</PackageId>
    <Version>2.8.1</Version>
    <Authors>Dmitry Balikhin</Authors>
    <Description>Dotnetarium security scanner for modern .NET projects</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/dotnetarium/dotnetarium</RepositoryUrl>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="SarifMetadata.json" LogicalName="Dotnetarium.SarifMetadata.json" />
    <EmbeddedResource Include="../docs/rules/DNA*.md" LogicalName="Dotnetarium.RuleHelp.%(Filename)%(Extension)" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="..\Roslyn\License.txt" Pack="true" PackagePath="roslyn" />
    <ProjectReference Include="..\Dotnetarium.Analyzers\Dotnetarium.Analyzers.csproj" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0-1.26529.118" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.12.0-1.26529.118" />
  </ItemGroup>
</Project>
