<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnetarium</ToolCommandName>
    <PackageId>dotnetarium</PackageId>
    <Version>2.3.0</Version>
    <Authors>Dmitry Balikhin</Authors>
    <Description>Dotnetarium security scanner for modern .NET projects</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/dotnetarium/dotnetarium</RepositoryUrl>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="..\Roslyn\License.txt" Pack="true" PackagePath="roslyn" />
    <ProjectReference Include="..\Dotnetarium.Analyzers\Dotnetarium.Analyzers.csproj" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
  </ItemGroup>
</Project>
